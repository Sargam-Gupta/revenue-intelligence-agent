# Copy this file to n8n/.env (gitignored) and fill in real values.
# These are injected into the n8n container for the pipeline nodes.

# Node 4 — Claude narrative call. ai/narrative_engine.py reads ANTHROPIC_API_KEY
# from the environment. (Local-only token spend; ~1 call per run.)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Node 5 — git push of the updated cache. A fine-grained PAT scoped to THIS repo
# with Contents: read/write (Pull requests not needed here). Used as:
#   git push https://x-access-token:${GH_TOKEN}@github.com/Sargam-Gupta/revenue-intelligence-agent.git HEAD:main
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
